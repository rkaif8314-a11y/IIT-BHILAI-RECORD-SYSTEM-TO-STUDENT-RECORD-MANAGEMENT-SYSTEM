def add_student():
    conn = get_connection()
    cur = conn.cursor()

    print("\nAdd new student")
    roll_no = input("Roll No: ").strip()
    name = input("Name: ").strip()
    department = input("Department: ").strip()
    program = input("Program: ").strip()
    year_in = input("Year (1-4): ").strip()
    section = input("Section: ").strip()
    age = input("Age: ").strip()
    address = input("Address: ").strip()
    father_name = input("Father Name: ").strip()
    mother_name = input("Mother Name: ").strip()

    try:
        age_val = int(age) if age else None
    except ValueError:
        print("\033[91mInvalid age. Using NULL.\033[0m")
