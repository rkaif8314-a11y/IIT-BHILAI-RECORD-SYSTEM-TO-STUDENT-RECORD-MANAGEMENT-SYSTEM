def get_all_courses():
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("SELECT course_code, course_name, instructor FROM courses ORDER BY course_code;")
    courses = cur.fetchall()
    conn.close()
    return courses


def add_or_update_marks():
    conn = get_connection()
    cur = conn.cursor()

    print("\nAdd / update marks")
    roll_no = input("Roll no: ").strip()

    cur.execute("SELECT name FROM students WHERE roll_no = ?;", (roll_no,))
    row = cur.fetchone()
    if not row:
        print("\033[91mStudent not found.\033[0m")
        conn.close()
        return

    print(f"For: {row[0]} ({roll_no})")

    courses = get_all_courses()
    for code, name, instr in courses:
        marks_in = input(f"Marks for {code} ({name}) [blank = skip]: ").strip()
        if marks_in == "":
            continue
        try:
            mval = float(marks_in)
        except ValueError:
            print("\033[91mInvalid marks. Skipped.\033[0m")
            continue

        cur.execute("""
        INSERT INTO marks (roll_no, course_code, marks)
        VALUES (?, ?, ?)
        ON CONFLICT(roll_no, course_code)
        DO UPDATE SET marks = excluded.marks;
        """, (roll_no, code, mval))

    conn.commit()
    conn.close()
    print("\033[92mMarks saved.\033[0m")


def absolute_grade(marks):
    if marks >= 90:
        return "A+"
    elif marks >= 80:
        return "A"
    elif marks >= 70:
        return "B"
    elif marks >= 60:
        return "C"
    elif marks >= 50:
        return "D"
    return "F"


def relative_grade(course_code, student_marks):
    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT marks FROM marks WHERE course_code = ?;", (course_code,))
    all_rows = cur.fetchall()
    conn.close()

    all_marks = [r[0] for r in all_rows if r[0] is not None]

    # If not enough data, use absolute grading
    if len(all_marks) < 2:
        return absolute_grade(student_marks)

    mean = sum(all_marks) / len(all_marks)
    variance = sum((m - mean) ** 2 for m in all_marks) / len(all_marks)
    std = math.sqrt(variance)

    # If no variation, use absolute
    if std == 0:
        return absolute_grade(student_marks)

    # friendlier relative bands
    if student_marks >= mean + std:
        rel = "A+"
    elif student_marks >= mean + 0.5 * std:
        rel = "A"
    elif student_marks >= mean:
        rel = "B"
    elif student_marks >= mean - 0.5 * std:
        rel = "C"
    else:
        rel = "D"

    # Never give worse grade than absolute
    abs_g = absolute_grade(student_marks)
    order = ["F", "D", "C", "B", "A", "A+"]

    return order[max(order.index(rel), order.index(abs_g))]


def generate_student_report():
    conn = get_connection()
    cur = conn.cursor()

    print("\nStudent report")
    roll_no = input("Roll no: ").strip()

    cur.execute("""
    SELECT roll_no, name, department, program, year, section, age,
           address, father_name, mother_name
    FROM students WHERE roll_no = ?;
    """, (roll_no,))
    s = cur.fetchone()
    if not s:
        print("\033[91mStudent not found.\033[0m")
        conn.close()
        return

    cur.execute("""
    SELECT m.course_code, c.course_name, c.instructor, m.marks
    FROM marks m
    JOIN courses c ON m.course_code = c.course_code
    WHERE m.roll_no = ?
    ORDER BY m.course_code;
    """, (roll_no,))
    marks_rows = cur.fetchall()

    cur.execute("""
    SELECT date, status FROM attendance
    WHERE roll_no = ?
    ORDER BY date;
    """, (roll_no,))
    att_rows = cur.fetchall()

    conn.close()

    print("\n" + "=" * 60)
    print("                STUDENT REPORT")
    print("=" * 60)
    print(f"Roll No     : {s[0]}")
    print(f"Name        : {s[1]}")
    print(f"Department  : {s[2]}")
    print(f"Program     : {s[3]}")
    print(f"Year        : {s[4]}")
    print(f"Section     : {s[5]}")
    print(f"Age         : {s[6]}")
    print(f"Address     : {s[7]}")
    print(f"Father Name : {s[8]}")
    print(f"Mother Name : {s[9]}")
    print("-" * 60)

    print("\nMarks & Grades:")
    if not marks_rows:
        print("No marks data.")
    else:
        print("{:<8} {:<25} {:<20} {:<7} {:<8}".format(
            "Code", "Course Name", "Instructor", "Marks", "Grade"))
        print("-" * 80)
        for code, cname, instr, mk in marks_rows:
            grade = relative_grade(code, mk)
            print("{:<8} {:<25} {:<20} {:<7} {:<8}".format(
                code, cname[:24], instr[:19], mk, grade
            ))

    print("\nAttendance:")
    if not att_rows:
        print("No attendance data.")
    else:
        total_present = sum(1 for d, st in att_rows if st.upper() == "P")
        total_records = len(att_rows)
        print(f"Present days : {total_present}")
        print(f"Total records: {total_records}")
        print("Dates present:")
        for d, st in att_rows:
            if st.upper() == "P":
                print(f"  - {d}")

    print("=" * 60 + "\n")


# -------- ATTENDANCE --------

def mark_attendance():
    conn = get_connection()
    cur = conn.cursor()

    print("\nMark attendance (P)")
    roll_no = input("Roll no: ").strip()
    date = input("Date (YYYY-MM-DD): ").strip()

    cur.execute("SELECT name FROM students WHERE roll_no = ?;", (roll_no,))
    row = cur.fetchone()
    if not row:
        print("\033[91mStudent not found.\033[0m")
        conn.close()
        return

    try:
        cur.execute("""
        INSERT INTO attendance (roll_no, date, status)
        VALUES (?, ?, 'P')
        ON CONFLICT(roll_no, date)
        DO UPDATE SET status = 'P';
        """, (roll_no, date))
        conn.commit()
        print(f"\033[92mMarked PRESENT for {row[0]} on {date}.\033[0m")
    except Exception as e:
        print("\033[91mError while marking attendance:\033[0m", e)

    conn.close()


